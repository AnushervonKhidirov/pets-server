generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  password  String
  phone     String @unique @db.VarChar(30)
  firstName String @db.VarChar(30)
  lastName  String @db.VarChar(30)

  @@map("user")
}
