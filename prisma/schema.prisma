generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String?  @db.VarChar(20)
  password  String?
  firstName String   @map("first_name") @db.VarChar(30)
  lastName  String?  @map("last_name") @db.VarChar(30)
  avatar    String?
  contacts  Json?
  authType  AuthType
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  tokens    Token[]
  address   Address?

  @@map("user")
}

model Address {
  id        Int     @id @default(autoincrement())
  address   String?
  latitude  Float?
  longitude Float?
  userId    Int     @unique @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("address")
}

model Token {
  refreshToken String   @unique
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiredAt    DateTime @map("expired_at") @db.Timestamp(0)

  @@map("token")
}

model Pets {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(30)
  sex         Sex
  birthday    DateTime
  microchipId String   @map("microchip_id")
  petType     PetType  @relation(fields: [petTypeId], references: [id])
  petTypeId   Int      @map("pet_type_id")
  breed       Breed    @relation(fields: [breedId], references: [id])
  breedId     Int      @map("breed_id")

  @@map("pets")
}

model PetType {
  id     Int     @id @default(autoincrement())
  en     String  @unique @db.VarChar(50)
  ru     String  @unique @db.VarChar(50)
  breeds Breed[]
  pets   Pets[]

  @@map("pet_type")
}

model Breed {
  id        Int     @id @default(autoincrement())
  en        String  @unique @db.VarChar(50)
  ru        String  @unique @db.VarChar(50)
  petType   PetType @relation(fields: [petTypeId], references: [id])
  petTypeId Int     @map("pet_type_id")
  pets      Pets[]

  @@map("breed")
}

enum AuthType {
  Local
  Google
  Yandex
}

enum Sex {
  Male
  Female
}
