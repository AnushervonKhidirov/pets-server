generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String?  @db.VarChar(20)
  password  String?
  firstName String   @map("first_name") @db.VarChar(30)
  lastName  String?  @map("last_name") @db.VarChar(30)
  avatar    String?
  contacts  Json?
  authType  AuthType
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  role      Role     @default(User)
  tokens    Token[]
  address   Address?
  pets      Pet[]

  @@map("user")
}

model Address {
  id        Int     @id @default(autoincrement())
  address   String?
  latitude  Float?
  longitude Float?
  userId    Int     @unique @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("address")
}

model Token {
  refreshToken String   @unique @db.VarChar(250)
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiredAt    DateTime @map("expired_at") @db.Timestamp(0)

  @@map("token")
}

model Pet {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(30)
  about       String?   @db.Text
  sex         Sex?
  birthday    DateTime?
  microchipId String?   @map("microchip_id")
  petType     PetType   @relation(fields: [petTypeId], references: [id])
  petTypeId   Int
  breed       Breed?    @relation(fields: [breedId], references: [id])
  breedId     Int?
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  image       String?
  lostInfo    LostInfo?

  @@map("pets")
}

model LostInfo {
  id      Int      @id @default(autoincrement())
  lostAt  DateTime
  details String?  @db.VarChar(255)
  address String?  @db.VarChar(255)
  petId   Int      @unique
  pet     Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("lost_info")
}

model PetType {
  id     Int     @id @default(autoincrement())
  en     String  @unique @db.VarChar(50)
  ru     String  @unique @db.VarChar(50)
  breeds Breed[]
  pets   Pet[]

  @@map("pet_type")
}

model Breed {
  id        Int     @id @default(autoincrement())
  en        String  @unique @db.VarChar(50)
  ru        String  @unique @db.VarChar(50)
  petType   PetType @relation(fields: [petTypeId], references: [id])
  petTypeId Int     @map("pet_type_id")
  pets      Pet[]

  @@map("breed")
}

model VetClinic {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(50)
  address   String
  latitude  Float
  longitude Float
  contacts  Json
  about     String? @db.Text
  image     String?

  @@map("vet_clinic")
}

model Message {
  id      Int     @id @default(autoincrement())
  topic   String  @db.VarChar(50)
  phone   String  @db.VarChar(20)
  message String  @db.Text
  watched Boolean @default(false)

  @@map("message")
}

enum AuthType {
  Local
  Google
  Yandex
}

enum Sex {
  Male
  Female
}

enum Role {
  User
  Admin
}
